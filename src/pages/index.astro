---
// Portfolio home — 1:1 port of the legacy Jekyll layout (_layouts/main.html on
// the legacy-site branch). Markup, class names and asset paths are unchanged so
// the page renders pixel-identical; only the templating changed (Liquid → Astro).
import fs from 'node:fs';
import work from '../data/work.yml';
import speaking from '../data/speaking.yml';
import experience from '../data/experience.yml';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Subtle rotating background: fully dynamic — every image in public/img/bg/
// joins the crossfade; timing is derived from the file count (as in Liquid).
const bgs = fs
	.readdirSync('./public/img/bg')
	.filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
	.sort()
	.map((f) => `img/bg/${f}`);
const slot = 16;
const dur = bgs.length * slot;
const vis = Math.floor(100 / (bgs.length || 1));
const hold = vis - 4;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content={SITE_DESCRIPTION}>
    <meta name="author" content="Taha Basri">
    <meta name="theme-color" content="#0b0f17">
    <meta property="og:type" content="website">
    <meta property="og:url" content={Astro.url}>
    <meta property="og:title" content={SITE_TITLE}>
    <meta property="og:description" content="Developer, Instructor, Tech Enthusiast & Coffee Aficionado.">
    <meta property="og:image" content={new URL('img/profile/default.png', Astro.site)}>
    <link rel="canonical" href={canonicalURL}>
    <link rel="sitemap" href="/sitemap-index.xml">
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)}>

    <!-- Favicons (generated set in favicon/) -->
    <link rel="icon" type="image/x-icon" href="favicon/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="favicon/apple-touch-icon.png">
    <link rel="manifest" href="favicon/site.webmanifest">

    <title>{SITE_TITLE}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=Space+Grotesk:wght@500;600;700&family=Caveat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="css/style.css" rel="stylesheet">
  </head>

  <body>
    <!-- ===================== SUBTLE ROTATING BACKGROUND ===================== -->
    {bgs.length > 0 && (
      <>
        <style set:html={`
      @keyframes bg-cycle {
        0%          { opacity: 0;    transform: scale(1.04); }
        4%          { opacity: 0.08; }
        ${hold}% { opacity: 0.08; }
        ${vis}%  { opacity: 0;    transform: scale(1.10); }
        100%        { opacity: 0;    transform: scale(1.10); }
      }
    `}></style>
        <div class="site-bg" aria-hidden="true">
          {bgs.map((path, i) => (
            <span style={`background-image:url('${path}'); animation: bg-cycle ${dur}s linear infinite; animation-delay: ${i * slot}s;`}></span>
          ))}
        </div>
      </>
    )}

    <!-- ===================== FLOATING PILL NAV ===================== -->
    <header id="nav" class="nav">
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav-links" id="navLinks">
        <a href="#work">Work</a>
        <a href="#speaking">Speaking</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
        <a href="/blog/" class="nav-ext">Blog <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </nav>
    </header>

    <!-- ===================== HERO ===================== -->
    <section class="hero" id="top">
      <div class="hero-sky" aria-hidden="true">
        <span class="cloud cloud-1"></span>
        <span class="cloud cloud-2"></span>
        <span class="cloud cloud-3"></span>
      </div>
      <!-- Hero figure. default = main photo; alternative glitches in for a few ms. -->
      <div class="hero-figure" aria-hidden="true">
        <img class="hero-img hero-img-default" src="img/profile/default.png" alt="">
        <img class="hero-img hero-img-alt" src="img/profile/alternative.png" alt="">
      </div>
      <div class="hero-inner reveal-up">
        <p class="hero-intro"><img class="wave" src="img/icons/wave.png" alt=""> Hey, I'm Taha</p>
        <h1 class="hero-title">
          <span class="hero-title-1">software</span>
          <span class="hero-title-2">engineer</span>
        </h1>
        <p class="hero-sub">
          Building &amp; teaching on the Salesforce Platform @
          <span class="hero-chip"><img src="img/companies/comp_SALESFORCE_logo.png" alt="Salesforce"></span>
        </p>
        <div class="hero-cta">
          <a class="btn-solid" href="#work">See my work <i class="fa-solid fa-arrow-down"></i></a>
          <a class="btn-outline" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero-foot">
        <span class="meta-left">
          <span class="meta-key">Based in</span>
          <img class="flag" src="img/icons/uae.png" alt="UAE"> UAE
          <span class="meta-dot">·</span>
          <span class="meta-key">from</span>
          <img class="flag" src="img/icons/morocco.png" alt="Morocco"> Morocco
        </span>
      </div>
    </section>

    <!-- ===================== WHAT I DO + STATS ===================== -->
    <section class="band what">
      <hr class="hairline">

      <div class="what-grid">
        <h2 class="statement" id="statement">
          I turn ideas into software people actually <em>love</em>: clean code, clear teaching, and the small details that quietly do the work.
        </h2>
      </div>

      <div class="stats">
        <div class="stat">
          <p class="stat-num"><span class="js-years" data-since="2018">{year - 2018}</span>+</p>
          <hr class="hairline">
          <p class="stat-label">Years building</p>
          <p class="stat-desc">software, teaching &amp; design across Salesforce, Oracle &amp; CGI</p>
        </div>
        <div class="stat">
          <p class="stat-num">3</p>
          <hr class="hairline">
          <p class="stat-label">Companies shipped at</p>
          <p class="stat-desc">
            <img class="stat-logo" src="img/companies/comp_SALESFORCE_logo.png" alt="Salesforce">
            <img class="stat-logo" src="img/companies/comp_ORACLE_logo.png" alt="Oracle">
            <img class="stat-logo" src="img/companies/comp_CGI_logo.png" alt="CGI">
          </p>
        </div>
      </div>
    </section>

    <!-- ===================== SELECTED WORK ===================== -->
    <section class="band work-head" id="work">
      <div class="head-center">
        <h2 class="big-title">check out some of my work</h2>
        <p class="muted center">A few things I've built, shipped &amp; written, and the thinking behind them.</p>
      </div>
    </section>

    <div class="cards" id="cards">
      {work.map((item, i) => (
        <article class:list={['card', { 'card-clay': item.accent === 'clay' }]} style={`--i:${i}`}>
          <div class="card-body">
            <div class="card-head">
              <span class="card-num">{String(i + 1).padStart(2, '0').slice(-2)}</span>
              <span class="card-year">{item.year}</span>
            </div>
            <h3 class="card-title">{item.title}</h3>
            <div class="chips">
              {item.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
            <p class="card-desc" set:html={item.desc}></p>
            <a class="btn-pill" href={item.link} target={item.internal ? undefined : '_blank'} rel={item.internal ? undefined : 'noopener'}>
              <span class="btn-arrow"><i class={item.icon || 'fa-solid fa-arrow-right'}></i></span> {item.cta}
            </a>
          </div>
          <div class="card-art">
            {item.images && item.images.length > 0 ? (
              <div class={`shots shots-${item.images.length}`}>
                {item.images.map((img) => (
                  <figure class="shot"><img src={img} alt={item.title} loading="lazy" /></figure>
                ))}
              </div>
            ) : (
              <div class="shots shots-icon">
                <figure class="shot shot-glyph"><i class={item.icon || 'fa-solid fa-arrow-right'}></i></figure>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- ===================== SPEAKING & COMMUNITY ===================== -->
    <section class="band speaking" id="speaking">
      <div class="head-center">
        <h2 class="big-title">sharing what I learn</h2>
        <p class="muted center">Six Trailblazer Community Conferences and a steady stream of community sessions.</p>
      </div>

      <div class="talk-grid" data-page-size="6">
        {speaking.conferences.map((c) => (
          <article class="talk">
            <div
              class:list={['talk-media', { 'talk-media-empty': !c.image }]}
              style={c.image ? `background-image:url('${c.image}')` : undefined}
            >
              {!c.image && <i class="fa-solid fa-microphone-lines" aria-hidden="true"></i>}
              {c.edition && <span class="talk-badge">{c.edition}</span>}
              {c.video && <a class="talk-play" href={c.video} target="_blank" rel="noopener" aria-label="Watch the talk"><i class="fa-solid fa-play"></i></a>}
            </div>
            <div class="talk-body">
              <p class="talk-event">{c.event}<span class="talk-loc"><i class="fa-solid fa-location-dot"></i> {c.location}</span></p>
              <h3 class="talk-topic">{c.topic}</h3>
              {c.video ? (
                <a class="talk-link" href={c.video} target="_blank" rel="noopener"><i class="fa-solid fa-play"></i> Watch the talk</a>
              ) : c.link ? (
                <a class="talk-link" href={c.link} target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> View</a>
              ) : null}
            </div>
          </article>
        ))}
      </div>

      <div class="community">
        <h3 class="community-head">Community &amp; meetups</h3>
        <div class="row-grid" data-page-size="6">
          {speaking.community.map((c) => (
            <article class="talk-row">
              <a
                class:list={['talk-row-media', { 'talk-media-empty': !c.image }]}
                style={c.image ? `background-image:url('${c.image}')` : undefined}
                href={c.video || c.link || undefined}
                target={c.video || c.link ? '_blank' : undefined}
                rel={c.video || c.link ? 'noopener' : undefined}
                aria-label={c.video ? 'Watch' : undefined}
              >
                {!c.image && <i class="fa-solid fa-users" aria-hidden="true"></i>}
                {c.video && <span class="talk-row-play"><i class="fa-solid fa-play"></i></span>}
              </a>
              <div class="talk-row-body">
                <p class="talk-event">{c.org}{c.edition && <span class="talk-year">{c.edition}</span>}</p>
                <h4 class="talk-row-topic">{c.topic}</h4>
                <p class="talk-loc"><i class="fa-solid fa-location-dot"></i> {c.location}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== ABOUT (Moroccan roots) ===================== -->
    <section class="band about" id="about">
      <span class="zellige-line" aria-hidden="true"></span>
      <div class="about-grid">
        <div class="about-gallery" aria-hidden="false">
          <figure class="frame frame-a"><img src="img/about/then.JPG" alt="The first computer I owned"><figcaption>first tech.</figcaption></figure>
          <figure class="frame frame-b"><img src="img/about/roots.jpg" alt="Meknes, Morocco"><figcaption>roots.</figcaption></figure>
          <figure class="frame frame-c"><img src="img/about/now.JPG" alt="Taha today"><figcaption>now.</figcaption></figure>
        </div>
        <div class="about-text">
          <h2 class="big-title left">from <em>Morocco</em>, with code</h2>
          <p>I'm Taha, a developer, consultant and instructor who grew up in <strong>Meknes</strong>, one of Morocco's old imperial cities. I studied there and started my career there, and something about a place built by hand over centuries stuck with me: the patience, the craft, the love of getting the small details exactly right. I bring the same to the software I make.</p>
          <p>My story with tech started young. I was a kid in <strong>2004</strong> the first time I sat in front of a computer, and I never really got up. That curiosity carried me from Java engineering in Morocco to the Salesforce platform, and eventually to <strong>Dubai</strong>, with a strong coffee (or a mint tea) never far away.</p>
          <p>These days I build and teach on Salesforce: shipping the solutions behind great customer experiences, and sharing what I learn through talks, writing and open source. If you're trying to make something complex feel simple, that's exactly the kind of problem I love, so let's build something.</p>
          <p class="signature">Taha · طه</p>
        </div>
      </div>
    </section>

    <!-- ===================== EXPERIENCE ===================== -->
    <section class="band experience" id="experience">
      <div class="head-left">
        <h2 class="big-title left">the journey so far</h2>
        <p class="muted">From enterprise consulting to the world's #1 CRM, building, teaching and shipping along the way.</p>
      </div>

      <div class="timeline" id="timeline">
        <div class="timeline-track">
          {experience.map((job, i) => (
            <div class={`tl-item ${i % 2 === 0 ? 'tl-up' : 'tl-down'}`}>
              <span class:list={['tl-date', { 'tl-current': job.current }]}>{job.current && <><span class="dot"></span>{' '}</>}{job.period}</span>
              <div class="xp-card">
                <div class="xp-head">
                  <img class="xp-logo" src={job.logo} alt={job.company} />
                </div>
                <p class="xp-role">{job.role}</p>
                <p class="xp-co"><i class="fa-solid fa-location-dot"></i> {job.location}</p>
                <ul class="xp-list">
                  {job.points.map((point) => <li set:html={point}></li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== CTA + FOOTER ===================== -->
    <section class="cta" id="contact">
      <div class="cta-sky" aria-hidden="true">
        <span class="cloud cloud-1"></span>
        <span class="cloud cloud-2"></span>
      </div>
      <div class="cta-inner">
        <h2 class="cta-title">
          lets <em class="cycle" id="cycle">build</em><br>
          incredible work together.
        </h2>
        <div class="cta-media" aria-hidden="true">
          <div class="cta-frame"><img src="img/misc/collab.jpg" alt=""></div>
        </div>
        <div class="cta-contact">
          <div class="cta-col">
            <p class="cta-key">Social</p>
            <div class="cta-social">
              <a href="https://www.linkedin.com/in/tahabasri/" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
              <a href="https://github.com/tahabasri" target="_blank" rel="noopener" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
              <a href="https://tahabasri.medium.com/" target="_blank" rel="noopener" aria-label="Medium"><i class="fa-brands fa-medium"></i></a>
              <a href="https://x.com/thetahabasri" target="_blank" rel="noopener" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
            </div>
          </div>
        </div>
        <hr class="cta-line">
        <p class="cta-copy">© {year} Taha Basri</p>
      </div>
      <div class="bigname" aria-hidden="true">TAHA&nbsp;BASRI</div>
    </section>

    <script is:inline src="scripts/index.js" defer></script>
  </body>
</html>
